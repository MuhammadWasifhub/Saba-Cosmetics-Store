# ============================================
# SABA COSMETICS - Environment Variables
# Copy this file to .env.local and fill in your real values
# ============================================ edit

# --- SUPABASE ---
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key (SECRET - used only server-side for admin actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- ADMIN PANEL ---
# Set your own secret password to log into /admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# Secret random string used to sign the admin login session (any long random text)
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# --- SITE ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
